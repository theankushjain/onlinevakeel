# Supabase Free Tier Configuration
# Get these from your Supabase Dashboard -> Project Settings -> API
# (Leave empty if using the built-in zero-config legal store)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# LLM Configuration (Free Options)
# 1. Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key

# 2. Or Local Ollama host (leave empty if using Gemini or built-in engine)
OLLAMA_BASE_URL=http://localhost:11434

# Environment
APP_ENV=development
PORT=8000

# Capstone BGE Embedding API (Optional / Zero-config fallback available)
EMBEDDING_BASE_URL=https://103.42.50.41:1035/v1
EMBEDDING_MODEL=bge-small-en-v1.5
EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_CA_CERT_PATH=certs/vm02-ca.crt

# Capstone Qwen3-8B Inference API (Optional / Gemini fallback available)
QWEN_BASE_URL=https://103.42.50.41:1031/v1
QWEN_MODEL=Qwen/Qwen3-8B
QWEN_API_KEY=your_qwen_api_key
QWEN_CA_CERT_PATH=certs/vm07-ca.crt
